rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function hasActivePremium() {
      return signedIn()
        && exists(/databases/$(database)/documents/premiumAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/premiumAccess/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/premiumAccess/$(request.auth.uid)).data.questionBankVersion == 500;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'createdAt', 'lastLoginAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'lastLoginAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.lastLoginAt == request.time;
      allow delete: if isAdmin();

      match /progress/{progressId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && progressId == 'summary'
          && request.resource.data.keys().hasOnly(['tests', 'correct', 'answered', 'updatedAt'])
          && request.resource.data.tests is int
          && request.resource.data.correct is int
          && request.resource.data.answered is int
          && request.resource.data.tests >= 0
          && request.resource.data.correct >= 0
          && request.resource.data.answered >= request.resource.data.correct
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }


    match /paymentRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'reference', 'amount', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'reference', 'amount', 'status', 'createdAt'])
        && requestId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email.size() <= 254
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 6
        && request.resource.data.reference.size() <= 40
        && request.resource.data.amount == 250
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow update: if isOwner(resource.data.uid)
        && requestId == request.auth.uid
        && resource.data.status == 'rejected'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'reference', 'amount', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email.size() <= 254
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 6
        && request.resource.data.reference.size() <= 40
        && request.resource.data.amount == 250
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'subject', 'message', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'subject', 'message', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 1
        && request.resource.data.subject.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isAdmin()
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'status', 'updatedAt', 'repliedBy'])
        && request.resource.data.reply is string
        && request.resource.data.reply.size() >= 1
        && request.resource.data.reply.size() <= 2000
        && request.resource.data.status == 'answered'
        && request.resource.data.repliedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /premiumQuestionBanks/{bankId} {
      allow read: if bankId == 'v1' && (isAdmin() || hasActivePremium());
      allow write: if isAdmin();
    }

    match /premiumAccess/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}